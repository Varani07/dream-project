Screen {
    background: $surface;
    color: $text;
}

#header { dock: top; }
#footer { dock: bottom; }

/* ------------------------------------------- MAIN MENU */
#menu_container {
    align: center middle;
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
    background: $panel;
}

#title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#subtitle {
    content-align: center middle;
    margin-bottom: 2;
}

#new_game, #load_game, #exit_game {
    width: 100%;
    height: 3;
    margin: 1 0;
    background: $primary 25%;
    border: tall $primary 50%;
    text-style: none;
}

#new_game:hover, #load_game:hover {
    background: $primary 50%;
    color: $text;
    border: tall $primary 70%;
}

#new_game:focus, #load_game:focus {
    background: $primary 50%;
    color: $text;
    text-style: bold;
    border: tall $accent 80%;
}

#exit_game {
    background: $error 30%;
    border: tall $error 50%;
}

#exit_game:hover {
    background: $error 50%;   
    border: tall $error 70%;
}

#exit_game:focus {
    background: $error 50%;
    color: $text;
    text-style: bold;
    border: tall $accent 80%;
}

/* ------------------------------------------- NEW GAME */
#new_game_container {
    align: center middle;
    width: 60;
    height: auto;
    padding: 2;
    border: round $primary;
    background: $panel;
}

#new_title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
}

#input_name {
    margin: 1 0;
    border: tall $accent;
}

#start, #back {
    width: 100%;
    height: 3;
    margin: 1 0;
    background: $primary 25%;
    border: tall $primary 50%;
    text-style: none;
}

#start:hover, #back:hover {
    background: $primary 50%;
    color: $text;
    border: tall $primary 70%;
}

#start:focus, #back:focus {
    background: $primary 50%;
    color: $text;
    text-style: bold;
    border: tall $accent 80%;
}

/* ------------------------------------------- LOAD GAME */

/* ------------------------------------------- GAME-RUNNING */
#game_root {
    width: 100%;
    height: 100%;
}

#top {
    height: 35%;
}

#map {
    width: 50%;
    border: round $primary;
    padding: 1;
}

.cell_btn {
    background: transparent;
    border: none;
    min-height: 1;
    height: 3;
    width: 6;
    padding: 0;
    content-align: center middle;
    color: $text;
}

.cell_btn:hover {
    background: $primary 25%;
    text-style: none;
}

.cell_btn:focus {
    background: $accent 30%;
    text-style: bold;
    border: none;
}

.cell_btn.-active {
    background: $accent 25%;
    border: none;
}

#status_col {
    width: 50%;
    height: 100%;
}

#status {
    width: 100%;
    height: 85%;
    border: round $secondary;
    padding: 1 2;
    background: $panel;
}

#time_bar Button {
    min-width: 14;
    width: auto;
    height: 3;
    color: $text;
    text-style: none;
    border: tall $primary 60%;
    content-align: center middle;
}

#btn_time_play {
    background: $success 35%;
    border: tall $success 60%;
}
#btn_time_play:hover  { background: $success 55%; border: tall $success 75%; }
#btn_time_play:focus  { background: $success 60%; border: tall $accent 80%; text-style: bold; }
#btn_time_play.-active{ background: $success 65%; border: tall $accent 80%; text-style: bold; }

#btn_time_stop {
    background: $warning 35%;
    border: tall $warning 60%;
}
#btn_time_stop:hover  { background: $warning 55%; border: tall $warning 75%; }
#btn_time_stop:focus  { background: $warning 60%; border: tall $accent 80%; text-style: bold; }
#btn_time_stop.-active{ background: $warning 65%; border: tall $accent 80%; text-style: bold; }

#btn_time_forward {
    background: $primary 35%;
    border: tall $primary 60%;
}
#btn_time_forward:hover  { background: $primary 60%; border: tall $primary 75%; }
#btn_time_forward:focus  { background: $primary 55%; border: tall $accent 80%; text-style: bold; }
#btn_time_forward.-active{ background: $primary 65%; border: tall $accent 80%; text-style: bold; }

#btn_time_60 {
    background: $accent 35%;
    border: tall $accent 60%;
}
#btn_time_60:hover  { background: $accent 55%; border: tall $accent 75%; }
#btn_time_60:focus  { background: $accent 60%; border: tall $accent 80%; text-style: bold; }
#btn_time_60.-active{ background: $accent 65%; border: tall $accent 80%; text-style: bold; }

#middle {
    height: 1fr;
}

#world_log {
    height: 1fr;          /* 1fr = "ocupa todo o espaço restante" */
    border: round $primary;
    padding: 0 1;
}